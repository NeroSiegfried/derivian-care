# Database — obtain a free PostgreSQL URL from neon.tech or Vercel Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend — get your API key from resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Where contact form submissions are sent (defaults to info@derivian.com)
CONTACT_EMAIL="info@derivian.com"

# The "from" address shown in emails (domain must be verified in Resend)
FROM_EMAIL="DeRivian Website <noreply@derivian.com>"
