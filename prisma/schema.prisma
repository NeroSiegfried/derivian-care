generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  subscribedAt     DateTime @default(now())
  unsubscribeToken String   @unique

  @@map("subscribers")
}

model Post {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  excerpt        String
  content        String
  category       String
  categoryKey    String
  featured       Boolean  @default(false)
  authorName     String
  authorInitials String
  authorRole     String
  readTime       Int
  publishedAt    DateTime
  imageUrl       String
  imageAlt       String
  tags           String[]

  @@map("posts")
}
